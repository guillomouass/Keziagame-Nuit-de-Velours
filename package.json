{
  "name": "a-la-conquete-du-coeur-de-kezia",
  "private": true,
  "version": "1.0.0",
  "description": "Mini-jeu romantique 2.5D : Guillo part à la conquête du cœur de Kezia.",
  "type": "module",
  "scripts": {
    "assets": "node scripts/generate-assets.mjs && node scripts/generate-audio.mjs",
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "build:pages": "vite build --outDir docs --emptyOutDir && node -e \"require('fs').writeFileSync('docs/.nojekyll','')\""
  },
  "dependencies": {
    "@fontsource/nunito": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "vite": "7.3.7",
    "vitest": "5.1.0"
  }
}
